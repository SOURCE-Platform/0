{
  "manifest_version": 3,
  "name": "Source Vault",
  "version": "0.1.0",
  "description": "Fill and save passwords from your Source Vault. Every fill is approved on your Mac or iPhone.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Source Vault" },
  "content_scripts": [{ "matches": ["https://*/*", "http://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }]
}

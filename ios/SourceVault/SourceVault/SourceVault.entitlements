<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- §22.3: the vault's own Keychain access group, shared with no other
	     app or extension. With exactly one group and no App Group, every
	     Keychain item this app adds lands here and every query searches
	     only here (review SEC-O2). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.racker.source-vault</string>
	</array>
</dict>
</plist>
